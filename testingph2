# runtime/agents/nondet_test.py
from anchor.core.actions import ToolCall, ModelCall, Done

async def decide_next_step(ctx):
    if not ctx.has_result("timestamp_step"):
        return ToolCall("timestamp_step", {"now": ctx.now()})
    
    ts = ctx.result_of("timestamp_step")
    
    if not ctx.has_result("random_step"):
        return ToolCall("random_step", {"rand": ctx.random()})
    
    rand = ctx.result_of("random_step")
    
    return Done({"timestamp": str(ts), "random": rand})

