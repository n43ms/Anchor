# Copy to .env for local, non-compose runs. docker-compose.yml sets these
# itself for the compose topology (ops/compose/docker-compose.yml) and does
# not read this file.

# --- Deployment mode (constitution → Console Surface and Deployment Modes) ---
# Fail-closed: unset or "false" is demonstration mode. Only docker-compose.yml
# (the local-mode topology) sets this to "true". Never set this on a public
# deployment.
ANCHOR_AUTHORING_EXECUTE=false

# --- Database (bootstrap only; timing/retry/concurrency values live in the
# `runtime_config` table, not here — see anchor/core/config) ---
ANCHOR_DATABASE_URL=postgresql://anchor:anchor@localhost:5432/anchor
ANCHOR_REDIS_URL=redis://localhost:6379/0

# --- Configuration profile: "demo" or "production" (research.md, data-model.md §9) ---
ANCHOR_CONFIG_PROFILE=demo

# --- Worker identity ---
# The fleet-slot label pool a worker may claim from. Comma-separated.
ANCHOR_WORKER_LABEL_POOL=worker-a,worker-b,worker-c

# --- Build identity, stamped into images at build time (see ops/compose Dockerfiles) ---
ANCHOR_CODE_VERSION=dev

# --- Web Console Frontend (web/) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
VITE_REPO_URL=https://github.com/n43ms/Anchor
